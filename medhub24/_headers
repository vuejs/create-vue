# Cloudflare Pages — response headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprint-free filenames, so HTML must revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/khmer-copy-tool.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS have no content hash either — keep them short-lived so a
# deploy is visible immediately, and let the CDN carry the load.
/css/*
  Cache-Control: public, max-age=300, must-revalidate
/js/*
  Cache-Control: public, max-age=300, must-revalidate
/locales/*
  Cache-Control: public, max-age=300, must-revalidate

# Immutable assets.
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# The Khmer copy editor is an internal tool. It is unlinked and entirely
# client-side (localStorage + BroadcastChannel, no server), so it is kept
# reachable for staff — but it must never appear in search results.
/khmer-copy-tool.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, max-age=0, must-revalidate
